# Docker-compose variables
Discord__ClientId=your_discord_client_id_here
Discord__ClientSecret=your_discord_client_secret_here

# C# APIS
VITE_LOGIN_API=/auth/discord/login
ASPNETCORE_ENVIRONMENT=Development
VITE_BASE_API=http://localhost:5154
ConnectionStrings__DefaultConnection=Host=postgres;Database=database;Username=postgres;Password=password

# DB - must match ConnectionString above
POSTGRES_USER=postgres
POSTGRES_DB=database
POSTGRES_PASSWORD=password

# pgAdmin dashboard login (localhost:8080)
PGADMIN_DEFAULT_PASSWORD=default_password
PGADMIN_DEFAULT_EMAIL=email@email.com
PGADMIN_PASSWORD=default_password
PGADMIN_EMAIL=email@email.com

# Resend email service
RESEND_API_KEY=your_resend_api_key_here

# Discord bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
